# /etc/nginx/sites-available/lmf.gorev.space
#
# Reverse proxy for LiteMLflow at https://lmf.gorev.space.
# Paired with: systemctl enable --now lmf
#
# The certificate must exist before this site is enabled (nginx -t rejects a
# `listen ... ssl` block without one). Obtain it first with
#   certbot certonly --nginx -d lmf.gorev.space
# provision.sh does this check. The HTTP block keeps a 301 → HTTPS.

# Brute-force guard for the password login. Behind this proxy every request
# reaches LiteMLflow from 127.0.0.1, so the app's own per-IP login limiter
# sees a single client; per-client limiting has to happen here.
# (Site files are included in the http{} context, where this directive lives.)
limit_req_zone $binary_remote_addr zone=lmf_login:10m rate=10r/m;

server {
    listen 80;
    listen [::]:80;
    server_name lmf.gorev.space;

    # Let certbot issue its challenges before redirecting.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # :443 is owned by the stream{} SNI demultiplexer
    # (/etc/nginx/stream.d/mtg.conf), which forwards non-mtg TLS here with
    # the real client address in a PROXY protocol header. Listening on :443
    # directly would collide with it and stop nginx from starting.
    listen 127.0.0.1:8443 ssl http2 proxy_protocol;
    server_name lmf.gorev.space;

    # Recover the real client IP from PROXY protocol so $remote_addr (and the
    # X-Real-IP / X-Forwarded-For / rate-limit keys derived from it) are not
    # all 127.0.0.1.
    set_real_ip_from 127.0.0.1;
    real_ip_header   proxy_protocol;

    ssl_certificate     /etc/letsencrypt/live/lmf.gorev.space/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lmf.gorev.space/privkey.pem;

    # Sensible TLS defaults; certbot will also touch these.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Tell upstream what scheme/host the client used.
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;

    # LiteMLflow streams artifact bodies up to 5 GiB; lift the default 1m cap.
    client_max_body_size 5G;

    # Keep upstream connection alive for fast successive API calls.
    proxy_http_version 1.1;
    proxy_set_header Connection "";

    # Reasonable timeouts: artifact uploads and big batches can be slow.
    proxy_connect_timeout 10s;
    proxy_send_timeout    300s;
    proxy_read_timeout    300s;
    send_timeout          300s;

    # Don't buffer streaming responses (artifact downloads, log streams).
    proxy_buffering off;
    proxy_request_buffering off;

    location / {
        proxy_pass http://127.0.0.1:5050;
    }

    location = /api/v1/auth/login {
        limit_req zone=lmf_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:5050;
    }

    access_log /var/log/nginx/lmf.access.log;
    error_log  /var/log/nginx/lmf.error.log;
}
